#--------------------------------------------------------------------
# Railway template (copied at container start only if .env is missing)
# Do not set app.baseURL here — the app uses RAILWAY_PUBLIC_DOMAIN.
# Do not force HTTPS here — Railway health checks use HTTP internally.
#--------------------------------------------------------------------
CI_ENVIRONMENT = production
app.forceGlobalSecureRequests = false
app.indexPage =

# DATABASE_URL is injected when the Postgres service is linked.
database.default.DBDriver = Postgre
database.default.port = 5432

encryption.key = hex2bin:13cf6f226501a4b3e5b93be73246ea721a91474934f538da251d7f233cbcc1b4
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
logger.threshold = 4
