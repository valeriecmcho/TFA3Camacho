#--------------------------------------------------------------------
# Railway Environment Configuration
#
# This file is used as a template for Railway deployment.
# Railway will automatically provide DATABASE_URL environment variable.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# For Railway, app.baseURL will be auto-detected from the request
# Leave empty for automatic detection
app.baseURL = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# For Railway, DATABASE_URL is automatically provided by Railway
# when you add a PostgreSQL service to your project.
# The application will automatically parse DATABASE_URL and configure
# the database connection.

# Local development settings (commented out for Railway)
# database.default.hostname = localhost
# database.default.database = tfa3camacho
# database.default.username = root
# database.default.password =
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Generate a random key for production: php spark key:generate
# For Railway, you can set this as an environment variable
encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
logger.threshold = 4
